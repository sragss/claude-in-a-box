# Claude Middleware Environment Variables
# Copy this file to .env and update the values as needed

# GitHub OAuth Configuration
# Get these from https://github.com/settings/applications/new
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Better Auth Configuration
# Generate a secure random string for production
BETTER_AUTH_SECRET="your-secure-random-secret-key"

# Server Configuration
PORT=8080
BASE_URL=http://localhost:8080

# Frontend Configuration
# Update this to match your frontend deployment URL
FRONTEND_URL=http://localhost:5173

# Container Configuration
# Internal container ports (usually don't need to change)
CONTAINER_WETTY_PORT=3001
CONTAINER_SSH_PORT=22